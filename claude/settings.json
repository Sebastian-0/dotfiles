{
	"env": {
		"EDITOR": "nvim",
		"VISUAL": "nvim"
	},
	"permissions": {
		"allow": [
			"Bash(gh repo view *)",
			"Bash(gh pr *)",
			"Bash(gh run *)",
			"Bash(gh api *)",
			"Bash(git commit *)",
			"Bash(git add *)",
			"Bash(git log *)",
			"Bash(git mv *)",
			"Bash(find *)",
			"Bash(df *)",
			"Bash(du *)",
			"Bash(ls *)",
			"Bash(jq *)",
			"Bash(wc *)",
			"Bash(grep *)",
			"Bash(black *)",
			"Bash(clang-format *)",
			"Bash(biome *)",
			"Bash(rustfmt *)",
			"Bash(shfmt *)",
			"Bash(lua-format *)",
			"Bash(zig fmt *)",
			"Search(*)",
			"Edit(/tmp/*)"
		],
		"deny": [
			"mcp__Nuclino__create_item",
			"mcp__Nuclino__update_item",
			"mcp__Nuclino__edit_item_content",
			"mcp__Nuclino__delete_item",
			"mcp__Nuclino__create_field",
			"mcp__Nuclino__update_field",
			"mcp__Nuclino__delete_field"
		]
	},
	"statusLine": {
		"type": "command",
		"command": "bash \"$HOME/.claude/statusline-command.sh\""
	},
	"tui": "fullscreen",
	"agentPushNotifEnabled": true,
	"skipAutoPermissionPrompt": true,
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$HOME/.claude/hooks/comment-length.py\"",
						"timeout": 10
					}
				]
			}
		]
	}
}
